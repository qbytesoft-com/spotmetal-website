---
const comparisonCategories = [
  {
    category: "Price Synchronization & Math",
    items: [
      {
        feature: "Price Sync Cadence",
        info: "Frequency at which catalog prices recalculate against live LBMA & NY spot rates.",
        manual: "Manual (1–2 days late)",
        spotmetal: "Sub-minute live auto-sync"
      },
      {
        feature: "Multi-Karat Math (8K–24K)",
        info: "Automated purity multiplier from 333 (8K) to 999.9 fine bullion.",
        manual: "Spreadsheet formula errors",
        spotmetal: "Instant precision purity engine"
      },
      {
        feature: "Multi-Currency Live FX Rates",
        info: "European Central Bank live conversion with manual exchange rate locks.",
        manual: false,
        spotmetal: "15+ Currencies Auto-Converted"
      }
    ]
  },
  {
    category: "Margin Protection & Cost Safeguards",
    items: [
      {
        feature: "Wholesale Margin Floor Guard",
        info: "Hard minimum price boundaries preventing below-cost sales during market flash crashes.",
        manual: false,
        spotmetal: true
      },
      {
        feature: "Tiered Weight Gram Brackets",
        info: "Dynamic percentage and fabrication fees scaled by fine gram weight brackets.",
        manual: "Flat markup only",
        spotmetal: "Dynamic gram bracket engine"
      },
      {
        feature: "Differential Tax (§25a UStG)",
        info: "European and German margin taxation scheme compliance for pre-owned jewelry & bullion.",
        manual: false,
        spotmetal: true
      }
    ]
  },
  {
    category: "Storefront & Catalog Integrations",
    items: [
      {
        feature: "Native Shopify Admin Block",
        info: "Preact UI block embedded directly inside the native Shopify product editing screen.",
        manual: false,
        spotmetal: true
      },
      {
        feature: "Storefront Live Spot Ticker",
        info: "High-performance customer-facing ticker bar displaying live precious metal rates.",
        manual: false,
        spotmetal: true
      },
      {
        feature: "Customer Scrap Buyback Widget",
        info: "Drop-in storefront appraisal calculator for customer scrap jewelry trade-ins.",
        manual: false,
        spotmetal: true
      },
      {
        feature: "1-Click Payout Draft Orders",
        info: "Instant generation of official Shopify Draft Orders for customer scrap payouts.",
        manual: false,
        spotmetal: true
      }
    ]
  }
];
---

<section class="problem-solution-section parallax-sheet py-28 md:py-36 px-4 sm:px-6 lg:px-8 bg-luminous-warm text-slate-900 border-t border-amber-300/40 rounded-t-[44px] sm:rounded-t-[60px] shadow-[0_-30px_70px_rgba(0,0,0,0.55)] -mt-16 sm:-mt-20 relative z-20 transition-transform">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="tag-label text-[#FF5E36] mb-3 tracking-widest font-bold">
      PROFIT VS. LOSS COMPARISON
    </div>
    <h2 class="text-3xl sm:text-5xl font-title text-slate-950 tracking-tight leading-tight font-bold">
      Stop Leaving Money <span class="gradient-warm-text font-bold">on the Table</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-slate-600 font-sans leading-relaxed">
      See exactly how manual precious metals pricing loses you margin versus the SpotMetal automated profit engine.
    </p>
  </div>

  <!-- Minimal Clean Comparison Table (Matching Reference Design) -->
  <div class="max-w-5xl mx-auto bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-xl shadow-amber-950/5">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[620px]">
        <!-- Table Column Headers -->
        <thead>
          <tr class="border-b border-slate-200/90 text-sm font-sans font-bold text-slate-900">
            <th class="py-4 px-6 w-5/12 font-bold text-slate-950">
              Feature Categories
            </th>
            <th class="py-4 px-6 w-3.5/12 text-center font-bold text-slate-900 border-l border-slate-100">
              Manual / Basic
            </th>
            <th class="py-4 px-6 w-3.5/12 text-center font-bold text-slate-950 bg-[#F3F4F6] border-l border-slate-200">
              SpotMetal Engine
            </th>
          </tr>
        </thead>

        <tbody>
          {comparisonCategories.map((group, groupIdx) => (
            <>
              <!-- Category Header Row -->
              <tr class={`bg-white border-t ${groupIdx > 0 ? 'border-t-slate-200' : 'border-t-slate-100'} border-b border-slate-200/90`}>
                <td colspan="3" class="py-3 px-6 text-sm font-bold font-sans text-slate-950 bg-slate-50/50 tracking-tight">
                  {group.category}
                </td>
              </tr>

              <!-- Items inside Category -->
              {group.items.map((item, rowIdx) => (
                <tr class="border-b border-slate-100 hover:bg-slate-50/40 transition-colors">
                  <!-- Feature Name + Info Tooltip -->
                  <td class="py-3.5 px-6 text-sm font-medium text-slate-900">
                    <div class="flex items-center gap-2">
                      <span>{item.feature}</span>
                      <span 
                        class="inline-flex items-center justify-center w-4 h-4 rounded-full text-[10px] text-slate-400 border border-slate-300 cursor-help hover:text-slate-700 hover:border-slate-400 transition-colors flex-shrink-0" 
                        title={item.info}
                        aria-label={item.info}
                      >
                        ⓘ
                      </span>
                    </div>
                  </td>

                  <!-- Manual Column (Middle) -->
                  <td class="py-3.5 px-6 text-center text-sm font-sans text-slate-600 border-l border-slate-100">
                    {typeof item.manual === 'boolean' ? (
                      item.manual ? (
                        <span class="text-slate-900 font-bold text-base">✓</span>
                      ) : (
                        <span class="text-slate-400 font-light text-base">✕</span>
                      )
                    ) : (
                      <span class="text-slate-700 text-xs sm:text-sm font-normal">{item.manual}</span>
                    )}
                  </td>

                  <!-- SpotMetal Column (Right, Shaded Background) -->
                  <td class="py-3.5 px-6 text-center text-sm font-sans text-slate-950 bg-[#F3F4F6] border-l border-slate-200/70">
                    {typeof item.spotmetal === 'boolean' ? (
                      item.spotmetal ? (
                        <span class="text-slate-950 font-bold text-base">✓</span>
                      ) : (
                        <span class="text-slate-400 font-light text-base">✕</span>
                      )
                    ) : (
                      <span class="text-slate-950 text-xs sm:text-sm font-semibold">{item.spotmetal}</span>
                    )}
                  </td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Bottom Highlight Summary Bar -->
    <div class="bg-slate-50 border-t border-slate-200 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div class="space-y-1">
        <div class="tag-label text-slate-500 font-mono text-xs font-bold">
          AVERAGE MERCHANT IMPACT
        </div>
        <div class="text-base sm:text-lg font-bold font-title text-slate-950">
          Recapture an estimated <span class="text-[#FF5E36] font-sans font-extrabold">+4.2%</span> gross margin across all precious metal sales.
        </div>
      </div>
      <a 
        href="https://apps.shopify.com/spotmetal-pricing-buyback" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="gradient-gold-btn px-7 py-3.5 rounded-xl text-sm font-bold text-slate-950 font-sans shadow-md whitespace-nowrap"
      >
        Automate My Store →
      </a>
    </div>
  </div>
</section>
