---
const comparisons = [
  {
    feature: "Price Synchronization",
    pain: "Manual updates 1–2 days late",
    painLoss: "-$120 / sale slippage",
    gain: "Sub-minute live spot auto-sync",
    gainProfit: "100% real-time accuracy"
  },
  {
    feature: "Multi-Karat Math (8K–24K)",
    pain: "Spreadsheet formula errors",
    painLoss: "Underpricing high-karat gold",
    gain: "Instant precision purity engine",
    gainProfit: "Zero calculation mistakes"
  },
  {
    feature: "Wholesale Margin Protection",
    pain: "No floor bounds during market drops",
    painLoss: "Accidental below-cost sales",
    gain: "Hard minimumPrice floor guard",
    gainProfit: "Guaranteed gross margin"
  },
  {
    feature: "Tiered Weight Brackets",
    pain: "Flat pricing ignores fabrication cost",
    painLoss: "Unprofitable heavy pieces",
    gain: "Dynamic gram bracket multipliers",
    gainProfit: "+15% extra margin on heavy items"
  },
  {
    feature: "Customer Scrap Trade-Ins",
    pain: "Missed buyback opportunities",
    painLoss: "Lost scrap to competitors",
    gain: "Storefront appraisal calculator",
    gainProfit: "Turnkey circular revenue loop"
  },
  {
    feature: "Shopify Catalog Workflow",
    pain: "Switching back & forth between tabs",
    painLoss: "Hours wasted updating variants",
    gain: "Native Product Admin Preact block",
    gainProfit: "1-Click instant configuration"
  }
];
---

<section class="problem-solution-section parallax-sheet py-28 md:py-36 px-4 sm:px-6 lg:px-8 bg-luminous-warm text-slate-900 border-t border-amber-300/40 rounded-t-[44px] sm:rounded-t-[60px] shadow-[0_-30px_70px_rgba(0,0,0,0.55)] -mt-16 sm:-mt-20 relative z-20 transition-transform">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="tag-label text-[#FF5E36] mb-3 tracking-widest font-bold">
      PROFIT VS. LOSS COMPARISON
    </div>
    <h2 class="text-3xl sm:text-5xl font-title text-slate-950 tracking-tight leading-tight">
      Stop Leaving Money <span class="italic font-normal gradient-warm-text">on the Table</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-slate-600 font-sans leading-relaxed">
      See exactly how manual precious metals pricing loses you margin versus the SpotMetal automated profit engine.
    </p>
  </div>

  <!-- High-Contrast Clean White Comparison Matrix Card -->
  <div class="max-w-5xl mx-auto bg-white/95 rounded-3xl border border-amber-200/80 overflow-hidden shadow-2xl shadow-amber-950/5 backdrop-blur-md">
    <!-- Table Column Headers -->
    <div class="grid grid-cols-12 bg-[#FFFDFB] border-b border-amber-100 p-5 sm:p-6 items-center text-sm font-sans font-bold text-slate-900">
      <div class="col-span-12 sm:col-span-4 text-slate-500 uppercase tracking-wider text-xs font-mono">
        FEATURE / AREA
      </div>
      <div class="col-span-12 sm:col-span-4 mt-3 sm:mt-0 flex items-center">
        <span class="px-3.5 py-1.5 rounded-full bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold flex items-center gap-1.5 shadow-sm">
          <span class="text-rose-600 font-bold">✕</span>
          <span>Manual (Without SpotMetal)</span>
        </span>
      </div>
      <div class="col-span-12 sm:col-span-4 mt-3 sm:mt-0 flex items-center">
        <span class="px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold flex items-center gap-1.5 shadow-sm">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>With SpotMetal Engine</span>
        </span>
      </div>
    </div>

    <!-- Comparison Rows -->
    <div class="divide-y divide-amber-100/60 bg-white">
      {comparisons.map((row, idx) => (
        <div class={`grid grid-cols-12 p-5 sm:p-6 items-center gap-4 sm:gap-6 transition-colors hover:bg-[#FFF8F4] ${idx % 2 === 0 ? 'bg-white' : 'bg-[#FFFBF8]'}`}>
          <!-- Feature Name -->
          <div class="col-span-12 sm:col-span-4">
            <div class="text-base font-bold text-slate-950 font-sans tracking-tight">
              {row.feature}
            </div>
          </div>

          <!-- Pain / Loss Column (Aligned with icon and badge) -->
          <div class="col-span-12 sm:col-span-4 flex flex-col justify-center">
            <div class="flex items-start gap-2.5">
              <span class="text-rose-600 font-bold text-sm mt-0.5 flex-shrink-0">✕</span>
              <div class="space-y-1.5">
                <div class="text-sm font-medium text-slate-700 font-sans leading-snug">
                  {row.pain}
                </div>
                <div>
                  <span class="inline-block px-2.5 py-0.5 rounded-md bg-rose-50 border border-rose-200/80 text-rose-700 text-xs font-sans font-semibold">
                    Loss: {row.painLoss}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Gain / Profit Column (Aligned with icon and badge) -->
          <div class="col-span-12 sm:col-span-4 flex flex-col justify-center">
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold text-sm mt-0.5 flex-shrink-0">✓</span>
              <div class="space-y-1.5">
                <div class="text-sm font-bold text-slate-950 font-sans leading-snug">
                  {row.gain}
                </div>
                <div>
                  <span class="inline-block px-2.5 py-0.5 rounded-md bg-emerald-50 border border-emerald-200/80 text-emerald-700 text-xs font-sans font-semibold">
                    Gain: {row.gainProfit}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Highlight Bar -->
    <div class="bg-gradient-to-r from-rose-50/70 via-[#FFFDFB] to-emerald-50/70 border-t border-amber-100 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div class="space-y-1">
        <div class="tag-label text-slate-500 font-mono">
          AVERAGE MERCHANT IMPACT
        </div>
        <div class="text-base sm:text-lg font-bold font-title text-slate-950">
          Recapture an estimated <span class="text-[#FF5E36] font-sans font-extrabold">+4.2%</span> gross margin across all precious metal sales.
        </div>
      </div>
      <a 
        href="https://apps.shopify.com/spotmetal-pricing-buyback" 
        target="_blank" 
        rel="noopener noreferrer"
        class="gradient-gold-btn px-7 py-3.5 rounded-xl text-sm font-bold text-slate-950 font-sans shadow-md whitespace-nowrap"
      >
        Automate My Store →
      </a>
    </div>
  </div>
</section>
