---
const pillars = [
  {
    category: "Formulas & Brackets",
    status: "Active Rule",
    title: "Smart Karat & Bracket Math",
    description: "Configure tiered gram markups and automated purity multipliers (8K–24K) with hard margin floor boundaries.",
    docUrl: "/docs/formula-basics-and-math",
    docLabel: "Read formula guide",
    preview: {
      title: "18K Yellow Gold Ring",
      highlight: "8.50g",
      rows: [
        { label: "Raw Spot ($94.59 × 0.75)", val: "$603.01" },
        { label: "+25% Markup + $60 Fee", val: "+$210.75" }
      ],
      totalLabel: "Catalog Price:",
      totalVal: "$813.76"
    }
  },
  {
    category: "Circular Buybacks",
    status: "Storefront Widget",
    title: "Customer Scrap Gold Trade-Ins",
    description: "Let customers get instant online appraisals for unwanted jewelry, automatically queueing official Shopify Draft Orders.",
    docUrl: "/docs/customer-inquiry-workflow",
    docLabel: "Explore buyback engine",
    preview: {
      title: "Customer Appraisal",
      highlight: "14K Scrap",
      rows: [
        { label: "Weight Submitted", val: "12.40g" },
        { label: "Payout Offer", val: "$482.50" }
      ],
      totalLabel: "Action:",
      totalVal: "Draft Order Created",
      isBadge: true
    }
  },
  {
    category: "Compliance & Taxes",
    status: "EU Statutory",
    title: "Margin Taxation Scheme (§25a)",
    description: "Comply with German and European differential tax laws for pre-owned jewelry & bullion with audit-proof invoice records.",
    docUrl: "/docs/differential-taxation-25a",
    docLabel: "See compliance docs",
    preview: {
      title: "Vintage Cartier Watch",
      highlight: "§25a UStG",
      rows: [
        { label: "Selling Price", val: "$4,200.00" },
        { label: "Acquisition Cost", val: "-$3,100.00" }
      ],
      totalLabel: "VAT on Margin ($1,100):",
      totalVal: "$175.63"
    }
  }
];
---

<section id="features" class="parallax-sheet py-28 md:py-36 px-4 sm:px-6 lg:px-8 bg-[#131417] text-white border-t border-white/10 rounded-t-[44px] sm:rounded-t-[60px] shadow-[0_-30px_70px_rgba(0,0,0,0.7)] -mt-16 sm:-mt-20 relative z-30 transition-transform">
  <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
    <div class="tag-label text-amber-400 mb-3 tracking-widest font-bold">
      THE SPOTMETAL ENGINE
    </div>
    <h2 class="text-3xl sm:text-5xl font-title text-white tracking-tight leading-tight font-bold">
      Engineered for How Precious <span class="text-amber-400 font-bold">Metal Merchants Work</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
      Three specialized modules built to automate live pricing math, protect gross margins, and open high-conversion circular trade-in channels on Shopify.
    </p>
  </div>

  <div class="pillars-grid grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 max-w-7xl mx-auto">
    {pillars.map(pillar => (
      <div class="pillar-card bg-[#18191E] border border-white/10 rounded-3xl p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-amber-400/40 hover:shadow-2xl hover:shadow-amber-500/5 group">
        <div class="space-y-6">
          <!-- Card Header: Category Tag Left + Status Pill Right -->
          <div class="flex items-center justify-between text-xs">
            <span class="text-amber-400 font-mono font-bold tracking-wider uppercase">
              {pillar.category}
            </span>
            <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300 font-mono text-[11px]">
              {pillar.status}
            </span>
          </div>

          <!-- Title & Description -->
          <div class="space-y-2.5">
            <h3 class="text-xl sm:text-2xl font-title text-white font-bold tracking-tight">
              {pillar.title}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              {pillar.description}
            </p>
          </div>

          <!-- Real Product Micro-Widget Preview -->
          <div class="rounded-2xl bg-[#0E0F12] border border-white/10 p-4 sm:p-5 space-y-3 font-mono text-xs shadow-inner">
            <div class="flex items-center justify-between pb-2 border-b border-white/5">
              <span class="text-slate-200 font-sans font-semibold">{pillar.preview.title}</span>
              <span class="text-amber-400 font-mono font-bold text-[11px] px-2 py-0.5 rounded bg-amber-400/10 border border-amber-400/20">{pillar.preview.highlight}</span>
            </div>
            
            <div class="space-y-2 text-slate-400 text-[11px]">
              {pillar.preview.rows.map(r => (
                <div class="flex items-center justify-between">
                  <span>{r.label}</span>
                  <span class="text-slate-200 font-mono">{r.val}</span>
                </div>
              ))}
            </div>

            <div class="flex items-center justify-between pt-2.5 border-t border-white/10 text-xs">
              <span class="text-slate-300 font-sans font-medium">{pillar.preview.totalLabel}</span>
              {pillar.preview.isBadge ? (
                <span class="px-2.5 py-1 rounded-md bg-amber-400/15 border border-amber-400/30 text-amber-300 font-sans font-bold text-[11px]">
                  {pillar.preview.totalVal}
                </span>
              ) : (
                <span class="text-amber-400 font-mono font-bold text-sm">
                  {pillar.preview.totalVal}
                </span>
              )}
            </div>
          </div>
        </div>

        <!-- Direct Documentation Link -->
        <a 
          href={pillar.docUrl} 
          class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between text-xs font-mono text-slate-400 group-hover:text-amber-400 transition-colors"
        >
          <span>{pillar.docLabel}</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    ))}
  </div>
</section>
