---
const whatsappUrl = "https://api.whatsapp.com/send/?phone=8801611032464&text=Hello+Spotmetal+Support%2C+I+need+help+to+setup.&type=phone_number&app_absent=0";

const services = [
  "(01) Bullion & Coin Sync",
  "(02) Dynamic Karat Formulas",
  "(03) Circular Buyback Engine",
  "(04) Differential Tax (§25a UStG)",
  "(05) Multi-Currency FX Lock"
];
---

<footer class="w-full bg-[#131417] text-white border-t border-white/5 pt-20 pb-0 px-4 sm:px-6 lg:px-8 relative overflow-hidden z-10">
  <div class="max-w-7xl mx-auto space-y-16">
    <!-- 1. Top Bar: Logo Left + Status Right -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pb-10 border-b border-white/10">
      <a href="/" class="flex items-center gap-3.5 group">
        <img 
          src="/spotmetal-3d-icon.jpg" 
          alt="SpotMetal 3D Icon" 
          class="w-10 h-10 rounded-xl object-cover shadow-md border border-amber-500/20 group-hover:scale-105 transition-transform"
        />
        <span class="text-2xl font-bold font-title text-white tracking-tight">
          SpotMetal
        </span>
      </a>

      <div class="flex items-center gap-4 text-xs font-mono text-slate-400">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Shopify App Store Verified</span>
        </span>
        <span class="hidden md:inline text-slate-700">•</span>
        <span class="hidden md:inline text-slate-400">AES-256 GCM Encrypted</span>
      </div>
    </div>

    <!-- 2. Main Columns: Big Editorial Headline Left + Solutions List Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Contact Column (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <h2 class="text-4xl sm:text-5xl font-title text-white tracking-tight font-medium leading-tight">
          Let’s Automate <br class="hidden sm:inline" />
          <span class="italic font-normal text-amber-400">Your Store.</span>
        </h2>
        
        <div class="space-y-2 text-sm sm:text-base font-sans text-slate-300">
          <div>
            <a href="mailto:support@qbytesoft.com" class="text-white font-semibold hover:text-amber-400 transition-colors">
              support@qbytesoft.com
            </a>
          </div>
          <div>
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-white font-semibold hover:text-emerald-400 transition-colors inline-flex items-center gap-2"
            >
              <span class="text-emerald-400 font-bold">💬</span>
              <span>+880 1611-032464 (WhatsApp Live Engineer)</span>
            </a>
          </div>
        </div>

        <div class="pt-2">
          <a 
            href="https://apps.shopify.com/spotmetal-pricing-buyback" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 font-sans font-bold text-xs uppercase tracking-wider hover:bg-slate-200 transition-all shadow-md"
          >
            <span>START 7-DAY FREE TRIAL</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Right Columns: Numbered Services (Matching Attachment 2) + Navigation -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-10">
        <!-- Numbered Solutions (Clean Normal Body Font) -->
        <div class="space-y-4">
          <div class="tag-label text-slate-400 font-mono">
            CAPABILITIES
          </div>
          <div class="divide-y divide-white/10 font-sans font-medium text-sm sm:text-base text-slate-200">
            {services.map(s => (
              <a href="#features" class="block py-3 hover:text-amber-400 transition-colors">
                {s}
              </a>
            ))}
          </div>
        </div>

        <!-- Quick Links -->
        <div class="space-y-4">
          <div class="tag-label text-slate-400 font-mono">
            ECOSYSTEM
          </div>
          <ul class="space-y-3 text-sm font-sans text-slate-300">
            <li><a href="#features" class="hover:text-white transition-colors">Features & Formulas</a></li>
            <li><a href="#pricing" class="hover:text-white transition-colors">Plans & Pricing</a></li>
            <li><a href="https://apps.shopify.com/spotmetal-pricing-buyback" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Shopify App Store Listing ↗</a></li>
            <li><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">WhatsApp Live Support ↗</a></li>
            <li><a href="/docs" class="hover:text-white transition-colors">Documentation Wiki</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3. Bottom Copyright Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-sans text-slate-500 border-t border-white/10">
      <div>
        © 2026 SpotMetal Technologies. All rights reserved.
      </div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="/terms" class="hover:text-white transition-colors">Terms & Condition</a>
        <span>•</span>
        <span class="text-amber-400 font-bold font-title">Official Shopify Partner</span>
      </div>
    </div>
  </div>

  <!-- 4. Giant Solid White Watermark with 3D SpotMetal Luxury Emblem Icon -->
  <div class="mt-12 sm:mt-20 pt-4 pb-12 sm:pb-16 select-none pointer-events-none text-center leading-none w-full max-w-full">
    <div class="flex items-center justify-center gap-3 sm:gap-6 max-w-full px-2">
      <span class="text-[14vw] sm:text-[16vw] font-black font-title tracking-tight text-white block leading-none whitespace-nowrap drop-shadow-[0_10px_30px_rgba(255,255,255,0.15)]">
        SpotMetal
      </span>
      <div class="w-[12vw] h-[12vw] sm:w-[13vw] sm:h-[13vw] max-w-[160px] max-h-[160px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl shadow-amber-500/30 border border-amber-500/40 transform rotate-12 flex-shrink-0">
        <img 
          src="/spotmetal-3d-icon.jpg" 
          alt="SpotMetal 3D Icon" 
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</footer>
