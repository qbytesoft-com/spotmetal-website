---
---

<header class="w-full sticky top-0 z-[100] backdrop-blur-xl bg-[#131417]/90 border-b border-white/10">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 py-3.5 flex items-center justify-between gap-4">
    <!-- Brand Logo (3D Icon Left + Docs Title) -->
    <div class="flex items-center gap-3 sm:gap-4">
      <!-- Mobile Sidebar Toggle Button -->
      <button 
        id="docs-sidebar-toggle-btn"
        type="button" 
        class="lg:hidden p-2 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:border-amber-500/30 transition-all flex items-center gap-1.5 text-xs font-mono"
        aria-label="Toggle documentation navigation"
      >
        <span class="text-sm">📑</span>
        <span class="hidden xs:inline">Menu</span>
      </button>

      <a href="/" class="flex items-center gap-3 group">
        <img 
          src="/spotmetal-3d-icon.jpg" 
          alt="SpotMetal 3D Icon" 
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl object-cover shadow-md border border-amber-500/20 group-hover:scale-105 transition-transform"
        />
        <span class="text-lg sm:text-xl font-bold font-title tracking-tight text-white group-hover:text-amber-400 transition-colors">
          SpotMetal
        </span>
      </a>
      <span class="text-slate-600 hidden sm:inline">/</span>
      <a href="/docs" class="text-xs sm:text-sm font-mono font-bold text-amber-400 hover:underline hidden sm:inline">
        Documentation Wiki
      </a>
    </div>

    <!-- Center Search Bar Trigger (⌘K) -->
    <div class="flex-1 max-w-md hidden md:block">
      <button 
        type="button" 
        data-open-search 
        class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-amber-500/30 text-slate-400 text-xs font-sans transition-all group shadow-inner"
      >
        <span class="flex items-center gap-2">
          <span>🔍</span>
          <span class="group-hover:text-white transition-colors">Search documentation & formulas...</span>
        </span>
        <kbd class="px-2 py-0.5 rounded bg-white/5 border border-white/10 font-mono text-[10px] text-slate-400">⌘K</kbd>
      </button>
    </div>

    <!-- Right Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Live Status Badge -->
      <div class="hidden xl:flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Systems Normal • v2.4</span>
      </div>

      <!-- Mobile Search Button -->
      <button 
        type="button" 
        data-open-search 
        class="md:hidden p-2 sm:p-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:text-white"
        aria-label="Search"
      >
        🔍
      </button>

      <!-- App Store Trial CTA -->
      <a 
        href="https://apps.shopify.com/spotmetal-pricing-buyback" 
        target="_blank" 
        rel="noopener noreferrer"
        class="gradient-gold-btn px-4 sm:px-6 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-950 font-sans shadow-md whitespace-nowrap"
      >
        <span class="hidden sm:inline">Install App (7-Day Trial)</span>
        <span class="sm:hidden">Install Trial</span>
      </a>
    </div>
  </div>
</header>
