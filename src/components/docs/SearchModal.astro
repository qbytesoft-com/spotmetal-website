---
import { docCategories, docArticles } from '../../data/docs';

const allArticles = Object.values(docArticles);
---

<div id="search-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-start justify-center pt-20 px-4">
  <div class="bg-[#1A1B20] border border-white/10 w-full max-w-2xl rounded-3xl p-6 shadow-2xl space-y-4">
    <!-- Search Input Bar -->
    <div class="flex items-center gap-3 pb-4 border-b border-white/10">
      <span class="text-xl text-slate-400">🔍</span>
      <input 
        id="docs-search-input" 
        type="text" 
        placeholder="Search documentation, formulas, liquid tags, error codes..." 
        class="w-full bg-transparent text-white placeholder:text-slate-500 text-base font-sans focus:outline-none"
      />
      <kbd class="px-2 py-1 bg-white/5 border border-white/10 rounded-lg text-xs font-mono text-slate-400">ESC</kbd>
    </div>

    <!-- Live Filtered Results -->
    <div id="search-results-list" class="max-h-96 overflow-y-auto space-y-2 py-2">
      <!-- Default Quick Links -->
      <div class="text-xs font-mono text-slate-400 uppercase tracking-wider px-2 py-1">Quick Links</div>
      {allArticles.map(art => (
        <a 
          href={`/docs/${art.slug}`} 
          class="search-item block p-3 rounded-xl hover:bg-white/5 transition-colors border border-transparent hover:border-amber-500/20"
          data-title={art.title.toLowerCase()}
          data-desc={art.description.toLowerCase()}
          data-cat={art.categoryTitle.toLowerCase()}
        >
          <div class="text-xs font-mono text-amber-400">{art.categoryTitle}</div>
          <div class="text-sm font-bold text-white font-sans mt-0.5">{art.title}</div>
          <div class="text-xs text-slate-400 mt-1 line-clamp-1">{art.description}</div>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('docs-search-input') as HTMLInputElement;
  const items = document.querySelectorAll('.search-item');

  function openSearch() {
    modal?.classList.remove('hidden');
    input?.focus();
  }

  function closeSearch() {
    modal?.classList.add('hidden');
    if (input) input.value = '';
    items.forEach(item => (item as HTMLElement).style.display = 'block');
  }

  // Keyboard shortcut (⌘K or Ctrl+K or Esc)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  // Global trigger buttons
  document.querySelectorAll('[data-open-search]').forEach(btn => {
    btn.addEventListener('click', openSearch);
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  // Client-side instant filter
  input?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    items.forEach(item => {
      const el = item as HTMLElement;
      const title = el.getAttribute('data-title') || '';
      const desc = el.getAttribute('data-desc') || '';
      const cat = el.getAttribute('data-cat') || '';
      if (!q || title.includes(q) || desc.includes(q) || cat.includes(q)) {
        el.style.display = 'block';
      } else {
        el.style.display = 'none';
      }
    });
  });
</script>
