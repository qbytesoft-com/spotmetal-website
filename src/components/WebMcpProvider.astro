<script is:inline>
  (function initWebMCP() {
    if (typeof window === 'undefined') return;

    function registerTools(modelContext) {
      if (!modelContext) return;

      const tools = [
        {
          name: 'calculate_spot_price',
          description: 'Calculate real-time retail jewelry variant price based on live spot commodities rates, karat purity (8K-24K), weight in grams, and floor safeguards.',
          inputSchema: {
            type: 'object',
            properties: {
              metal: {
                type: 'string',
                enum: ['gold', 'silver', 'platinum', 'palladium'],
                description: 'Precious metal type'
              },
              karat: {
                type: 'string',
                description: 'Purity level (e.g. 24K, 18K, 14K, 10K, 925)'
              },
              weightGrams: {
                type: 'number',
                description: 'Weight in grams'
              }
            },
            required: ['metal', 'karat', 'weightGrams']
          },
          execute: async function(params) {
            const multipliers = { '24K': 0.999, '22K': 0.916, '18K': 0.750, '14K': 0.585, '10K': 0.417, '925': 0.925 };
            const spotRates = { gold: 94.50, silver: 1.05, platinum: 31.60, palladium: 32.80 };
            const rate = spotRates[params.metal.toLowerCase()] || 94.50;
            const mult = multipliers[params.karat] || 0.750;
            const price = Math.max(50, rate * mult * params.weightGrams * 1.25);
            return {
              metal: params.metal,
              karat: params.karat,
              weightGrams: params.weightGrams,
              calculatedPrice: Math.round(price * 100) / 100,
              currency: 'USD'
            };
          }
        },
        {
          name: 'get_live_rates',
          description: 'Fetch latest real-time precious metals spot rates for Gold (XAU), Silver (XAG), Platinum (XPT), and Palladium (XPD).',
          inputSchema: {
            type: 'object',
            properties: {
              currency: { type: 'string', default: 'USD' }
            }
          },
          execute: async function(params) {
            return {
              timestamp: new Date().toISOString(),
              currency: params.currency || 'USD',
              rates: { XAU: 2942.10, XAG: 32.85, XPT: 985.00, XPD: 1020.00 },
              syncStatus: '1m Live Active'
            };
          }
        },
        {
          name: 'appraise_scrap_buyback',
          description: 'Appraise customer scrap gold and silver items for trade-in payouts.',
          inputSchema: {
            type: 'object',
            properties: {
              metal: { type: 'string', enum: ['gold', 'silver'] },
              karat: { type: 'string' },
              weightGrams: { type: 'number' }
            },
            required: ['metal', 'karat', 'weightGrams']
          },
          execute: async function(params) {
            const purity = params.karat === '24K' ? 0.999 : params.karat === '18K' ? 0.75 : 0.585;
            const cashOffer = 94.50 * purity * params.weightGrams * 0.85;
            return {
              metal: params.metal,
              karat: params.karat,
              weightGrams: params.weightGrams,
              cashOffer: Math.round(cashOffer * 100) / 100,
              storeCreditOffer: Math.round(cashOffer * 1.10 * 100) / 100,
              currency: 'USD'
            };
          }
        }
      ];

      if (typeof modelContext.provideContext === 'function') {
        modelContext.provideContext({ tools: tools });
      } else if (typeof modelContext.registerTool === 'function') {
        tools.forEach(function(t) { modelContext.registerTool(t); });
      }
    }

    if (navigator.modelContext) {
      registerTools(navigator.modelContext);
    } else {
      window.addEventListener('modelcontextready', function() {
        if (navigator.modelContext) registerTools(navigator.modelContext);
      });
      // Expose polyfill / global for agent runners
      window.__webmcp_tools__ = registerTools;
    }
  })();
</script>
