---
---

<section id="showcase" class="parallax-sheet py-28 md:py-36 px-4 sm:px-6 lg:px-8 bg-luminous-light text-slate-900 border-t border-amber-300/40 rounded-t-[44px] sm:rounded-t-[60px] shadow-[0_-30px_70px_rgba(0,0,0,0.55)] -mt-16 sm:-mt-20 space-y-32 relative z-20 transition-transform">
  <!-- Showcase 1: Native Admin Block -->
  <div class="showcase-row grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center max-w-7xl mx-auto">
    <div class="lg:col-span-6 space-y-6">
      <div class="tag-label text-[#FF5E36] font-bold">
        SEAMLESS SHOPIFY INTEGRATION
      </div>
      <h2 class="text-3xl sm:text-5xl font-title text-slate-950 leading-tight font-medium">
        Configure Metals Directly Inside <span class="italic font-normal gradient-warm-text">Product Admin</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
        No more jumping between different dashboards. SpotMetal embeds a native Preact UI block right into Shopify's native Product editing page. Assign metal types, karats (8K–24K), fine weights, and price floors on the fly.
      </p>
      <ul class="space-y-3 text-sm sm:text-base text-slate-700 font-sans">
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Native Shopify App Bridge UI extension</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Granular variant overrides (Fine Grams or Fractional Troy Oz)</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Hard price floor bounds to prevent below-cost selling</span>
        </li>
      </ul>
    </div>

    <!-- UI Representation (Card) -->
    <div class="lg:col-span-6 bg-white/95 rounded-3xl p-7 sm:p-10 shadow-2xl shadow-amber-950/5 border border-amber-200/80 backdrop-blur-md">
      <div class="flex items-center justify-between pb-5 border-b border-slate-100">
        <div class="text-sm font-title font-bold text-slate-950 flex items-center gap-2.5">
          <span>📦</span>
          <span>SpotMetal Variant Pricing Block (Shopify Native)</span>
        </div>
        <span class="text-xs font-mono text-slate-400">ID: #849102</span>
      </div>

      <div class="mt-6 bg-[#131417] rounded-2xl p-5 border border-white/5 space-y-4 text-white">
        <div class="grid grid-cols-4 text-[11px] font-mono text-slate-400 uppercase border-b border-white/10 pb-3">
          <div>Variant</div>
          <div>Metal/Purity</div>
          <div>Fine Wt</div>
          <div class="text-right">Live Price</div>
        </div>
        <div class="grid grid-cols-4 text-xs sm:text-sm font-sans text-slate-200 py-2 items-center border-b border-white/10">
          <div class="font-medium text-white">18K Gold Sz 7</div>
          <div class="text-amber-400 font-mono">18K (750)</div>
          <div class="font-mono">8.50g</div>
          <div class="text-right font-mono font-bold text-emerald-400">$745.20</div>
        </div>
        <div class="grid grid-cols-4 text-xs sm:text-sm font-sans text-slate-200 py-2 items-center">
          <div class="font-medium text-white">14K White Sz 7</div>
          <div class="text-amber-400 font-mono">14K (585)</div>
          <div class="font-mono">7.80g</div>
          <div class="text-right font-mono font-bold text-emerald-400">$532.80</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Showcase 2: Live Rates & FX Console -->
  <div class="showcase-row grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center max-w-7xl mx-auto">
    <!-- UI Representation (Left) -->
    <div class="lg:col-span-6 order-2 lg:order-1 bg-white/95 rounded-3xl p-7 sm:p-10 shadow-2xl shadow-amber-950/5 border border-amber-200/80 backdrop-blur-md">
      <div class="flex items-center justify-between pb-5 border-b border-slate-100">
        <div class="text-sm font-title font-bold text-slate-950 flex items-center gap-2.5">
          <span>📈</span>
          <span>Live Spot Rates & FX Engine (USD/EUR)</span>
        </div>
        <span class="text-xs font-mono text-emerald-700 font-bold">● Live Feed Active</span>
      </div>

      <div class="mt-6 grid grid-cols-3 gap-4">
        <div class="bg-[#131417] rounded-2xl p-4 border border-white/5 text-center text-white">
          <div class="text-[11px] font-mono text-amber-400">GOLD (XAU)</div>
          <div class="text-xl font-bold font-title text-white mt-1.5">$2,942.10</div>
          <div class="text-[10px] font-mono text-slate-400">$94.59/g</div>
        </div>
        <div class="bg-[#131417] rounded-2xl p-4 border border-white/5 text-center text-white">
          <div class="text-[11px] font-mono text-slate-300">SILVER (XAG)</div>
          <div class="text-xl font-bold font-title text-white mt-1.5">$32.85</div>
          <div class="text-[10px] font-mono text-slate-400">$1.05/g</div>
        </div>
        <div class="bg-[#131417] rounded-2xl p-4 border border-white/5 text-center text-white">
          <div class="text-[11px] font-mono text-slate-300">PLATINUM (XPT)</div>
          <div class="text-xl font-bold font-title text-white mt-1.5">$985.00</div>
          <div class="text-[10px] font-mono text-slate-400">$31.67/g</div>
        </div>
      </div>

      <div class="mt-6 bg-[#FFFDFB] rounded-2xl p-4 border border-amber-100 flex items-center justify-between text-xs font-mono text-slate-700">
        <span class="text-amber-800 font-medium">💱 EUR/USD Live: 1.0850 • Lock Override: Active</span>
        <span class="text-emerald-700 font-bold">15 Languages</span>
      </div>
    </div>

    <!-- Text Description (Right) -->
    <div class="lg:col-span-6 order-1 lg:order-2 space-y-6">
      <div class="tag-label text-[#FF5E36] font-bold">
        GLOBAL SPOT PRECISION
      </div>
      <h2 class="text-3xl sm:text-5xl font-title text-slate-950 leading-tight font-medium">
        Multi-Currency Spot Rates & <span class="italic font-normal gradient-warm-text">Manual FX Overrides</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
        Whether you price in USD, EUR, GBP, or 15+ international currencies, SpotMetal ingests high-accuracy spot feeds with automatic European Central Bank FX conversion. Lock manual exchange rates to hedge against currency fluctuations.
      </p>
      <ul class="space-y-3 text-sm sm:text-base text-slate-700 font-sans">
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Pre-integrated system feed (Edelmetalle.de) or custom API keys</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>AES-256 GCM encrypted credential storage</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Full support for 15 store languages</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Showcase 3: Inbound Buyback Queue -->
  <div class="showcase-row grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center max-w-7xl mx-auto">
    <div class="lg:col-span-6 space-y-6">
      <div class="tag-label text-emerald-700 font-bold">
        CIRCULAR TRADE-IN REVENUE
      </div>
      <h2 class="text-3xl sm:text-5xl font-title text-slate-950 leading-tight font-medium">
        Capture Customer Scrap Gold & <span class="italic font-normal text-emerald-700">Issue 1-Click Draft Orders</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
        Turn your storefront into a double-sided acquisition hub. Customers submit their old jewelry and bullion trade-ins via customizable appraisal widgets. Review submissions and issue official Shopify Draft Orders in seconds.
      </p>
      <ul class="space-y-3 text-sm sm:text-base text-slate-700 font-sans">
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Drop-in Buyback Calculator Liquid widget</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Automated shadow product listings with <code class="text-amber-700 font-bold">BB-*</code> SKUs</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
          <span>Direct conversion to Shopify Draft Orders for payouts</span>
        </li>
      </ul>
    </div>

    <!-- UI Representation (Card) -->
    <div class="lg:col-span-6 bg-white/95 rounded-3xl p-7 sm:p-10 shadow-2xl shadow-amber-950/5 border border-amber-200/80 backdrop-blur-md">
      <div class="flex items-center justify-between pb-5 border-b border-slate-100">
        <div class="text-sm font-title font-bold text-slate-950 flex items-center gap-2.5">
          <span>📥</span>
          <span>Inbound Customer Buyback Queue</span>
        </div>
        <span class="text-xs font-mono text-amber-700 font-bold">3 Pending Reviews</span>
      </div>

      <div class="mt-6 bg-[#131417] rounded-2xl p-5 border border-white/5 flex items-center justify-between text-white">
        <div>
          <div class="text-base font-bold font-title text-white">BB-1042 • Eleanor Vance</div>
          <div class="text-xs text-slate-400 mt-1">14K Scrap Chain (18.2g)</div>
          <div class="text-xs font-mono font-bold text-amber-400 mt-1.5">Appraisal Offer: $684.50</div>
        </div>
        <button class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-sans font-bold text-xs transition-colors shadow-sm">
          Create Draft Order
        </button>
      </div>
    </div>
  </div>
</section>
