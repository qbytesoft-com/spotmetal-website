        class="mobile-menu-link text-2xl font-bold font-title text-white hover:text-amber-400 py-3.5 flex items-center justify-between transition-colors group"
      >
        <span>Pricing</span>
        <span class="text-slate-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all text-xl font-normal">→</span>
      </a>

      <a 
        href="/docs" 
        class="mobile-menu-link text-2xl font-bold font-title text-amber-300 hover:text-amber-400 py-3.5 flex items-center justify-between transition-colors group"
      >
        <span>Documentation Wiki</span>
        <span class="text-amber-400 group-hover:translate-x-1 transition-all text-xl font-normal">→</span>
      </a>

      <a 
        href="#faq" 
        class="mobile-menu-link text-2xl font-bold font-title text-white hover:text-amber-400 py-3.5 flex items-center justify-between transition-colors group"
      >
        <span>FAQ</span>
        <span class="text-slate-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all text-xl font-normal">→</span>
      </a>
    </nav>

    <!-- Bottom Action CTA (Vibrant Gradient Button) -->
    <div class="pt-2 space-y-4">
      <a 
        href="https://apps.shopify.com/spotmetal-pricing-buyback" 
        target="_blank" 
        rel="noopener noreferrer"
        class="block w-full text-center gradient-gold-btn py-4 rounded-2xl font-bold text-slate-950 font-sans text-base shadow-xl shadow-amber-500/20"
