<!-- Mobile Bottom Sheet Drawer Navigation (Appears from Bottom) -->
<div id="mobile-menu-backdrop" class="fixed inset-0 z-[110] bg-black/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 md:hidden flex flex-col justify-end">
  <div 
    id="mobile-menu-sheet" 
    class="w-full bg-[#131417] border-t border-amber-500/20 rounded-t-[36px] sm:rounded-t-[44px] p-6 sm:p-8 max-h-[90vh] overflow-y-auto shadow-[0_-20px_50px_rgba(0,0,0,0.8)] transform translate-y-full transition-transform duration-300 ease-out space-y-6"
  >
    <!-- Sheet Drag Handle & Top Header -->
    <div class="space-y-4">
      <div class="w-12 h-1.5 rounded-full bg-white/20 mx-auto"></div>
      
      <div class="flex items-center justify-between pb-3 border-b border-white/10">
        <!-- Logo (Clickable Link to Home) -->
        <a href="/" class="flex items-center gap-3 group mobile-menu-link">
          <img 
            src="/spotmetal-3d-icon.jpg" 
            alt="SpotMetal 3D Icon" 
            class="w-8 h-8 rounded-xl object-cover border border-amber-500/20 group-hover:scale-105 transition-transform"
          />
          <span class="text-xl font-bold font-title text-white group-hover:text-amber-400 transition-colors">
            SpotMetal
          </span>
        </a>

        <!-- Close Button -->
        <button 
          id="mobile-menu-close-btn"
          type="button" 
          aria-label="Close menu"
          class="p-2 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Navigation Menu Items (Big Editorial Bold Style Matching Screenshot 2) -->
    <nav class="space-y-1 divide-y divide-white/5">
      <a 
        href="#features" 
        class="mobile-menu-link text-2xl font-bold font-title text-white hover:text-amber-400 py-3.5 flex items-center justify-between transition-colors group"
      >
        <span>Features</span>
        <span class="text-slate-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all text-xl font-normal">→</span>
      </a>

      <a 
        href="#how-it-works" 
        class="mobile-menu-link text-2xl font-bold font-title text-white hover:text-amber-400 py-3.5 flex items-center justify-between transition-colors group"
      >
        <span>How It Works</span>
        <span class="text-slate-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all text-xl font-normal">→</span>
      </a>

      <a 
        href="#showcase" 
        class="mobile-menu-link text-2xl font-bold font-title text-white hover:text-amber-400 py-3.5 flex items-center justify-between transition-colors group"
      >
        <span>Integrations</span>
        <span class="text-slate-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all text-xl font-normal">→</span>
