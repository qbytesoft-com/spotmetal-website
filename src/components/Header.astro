          href="https://api.whatsapp.com/send/?phone=8801611032464&text=Hello+Spotmetal+Support%2C+I+need+help+to+setup.&type=phone_number&app_absent=0"
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-amber-400 transition-colors flex items-center gap-1.5"
        >
          <span>💬 WhatsApp Live Support</span>
        </a>
        <a href="mailto:support@qbytesoft.com" class="hover:text-white transition-colors">
          support@qbytesoft.com
        </a>
      </div>
    </div>
