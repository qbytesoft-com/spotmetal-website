---
const metalsRow = [
  { name: "Gold 24K (999.9)", price: "$94.59/g", change: "+0.8%", color: "text-amber-400" },
  { name: "Gold 22K (916)", price: "$86.72/g", change: "+0.8%", color: "text-amber-400" },
  { name: "Gold 18K (750)", price: "$70.94/g", change: "+0.8%", color: "text-amber-300" },
  { name: "Gold 14K (585)", price: "$55.34/g", change: "+0.8%", color: "text-amber-300" },
  { name: "Gold 10K (417)", price: "$39.44/g", change: "+0.8%", color: "text-amber-200" },
  { name: "Gold 9K (375)", price: "$35.47/g", change: "+0.8%", color: "text-amber-200" },
  { name: "Gold 8K (333)", price: "$31.50/g", change: "+0.8%", color: "text-amber-200" },
  { name: "Silver 999 Fine", price: "$1.05/g", change: "+1.4%", color: "text-slate-300" },
  { name: "Platinum 950", price: "$31.67/g", change: "-0.2%", color: "text-slate-300" },
  { name: "Palladium 950", price: "$32.79/g", change: "+0.5%", color: "text-slate-300" },
];

const featuresRow = [
  { icon: "🛡️", title: "Minimum Margin Floor Protection", desc: "Wholesale Cost Shield" },
  { icon: "⚡", title: "Sub-Minute Price Synchronization", desc: "Real-Time Spot Engine" },
  { icon: "🧮", title: "Tiered Weight Bracket Formulas", desc: "Custom Fabrication Fees" },
  { icon: "🔄", title: "Circular Buyback & Trade-Ins", desc: "Storefront Appraisal Loop" },
  { icon: "📦", title: "Native Shopify Admin Block", desc: "Zero External Dashboard" },
  { icon: "⚖️", title: "Differential Tax (§25a UStG)", desc: "EU Margin Scheme" },
  { icon: "🔒", title: "AES-256 GCM Encrypted Vault", desc: "Private API Keys" },
  { icon: "🌍", title: "15+ Global Multi-Currencies", desc: "ECB Live Rates & Manual Lock" },
  { icon: "📑", title: "1-Click Shopify Draft Orders", desc: "Instant Payout Invoices" },
];
---

<section class="w-full py-12 bg-[#070A0F]/80 border-y border-white/5 overflow-hidden space-y-5 select-none relative z-10">
  <!-- Gradient Edge Fade Masks -->
  <div class="pointer-events-none absolute inset-y-0 left-0 w-24 sm:w-48 bg-gradient-to-r from-[#070A0F] to-transparent z-20"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-24 sm:w-48 bg-gradient-to-l from-[#070A0F] to-transparent z-20"></div>

  <!-- Row 1: Left-to-Right Scrolling (Rightwards Marquee) -->
  <div class="marquee-wrapper overflow-hidden flex">
    <div class="animate-marquee-right flex items-center gap-4">
      {metalsRow.concat(metalsRow).concat(metalsRow).map(m => (
        <div class="glass-card rounded-2xl py-3 px-5 flex items-center gap-3 border border-white/10 shadow-md">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span class="text-xs font-mono font-bold text-white whitespace-nowrap">{m.name}</span>
          <span class={`text-xs font-mono font-extrabold ${m.color}`}>{m.price}</span>
          <span class="text-[10px] font-mono font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-1.5 py-0.5 rounded">{m.change}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Row 2: Right-to-Left Scrolling (Leftwards Marquee) -->
  <div class="marquee-wrapper overflow-hidden flex">
    <div class="animate-marquee-left flex items-center gap-4">
      {featuresRow.concat(featuresRow).concat(featuresRow).map(f => (
        <div class="glass-card rounded-2xl py-3 px-5 flex items-center gap-3 border border-white/10 shadow-md">
          <span class="text-base">{f.icon}</span>
          <span class="text-xs font-title font-bold text-white whitespace-nowrap">{f.title}</span>
          <span class="text-[11px] font-mono text-slate-400 border-l border-white/10 pl-2.5 whitespace-nowrap">{f.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>
