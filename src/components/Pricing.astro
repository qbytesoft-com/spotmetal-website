---
---

<section id="pricing" class="parallax-sheet py-28 md:py-36 px-4 sm:px-6 lg:px-8 bg-luminous-warm text-slate-900 border-t border-amber-300/40 rounded-t-[44px] sm:rounded-t-[60px] shadow-[0_-30px_70px_rgba(0,0,0,0.55)] -mt-16 sm:-mt-20 relative z-20 transition-transform">
  <!-- Plan Header & Toggle Box -->
  <div class="bg-white/95 rounded-3xl p-8 sm:p-12 text-center max-w-5xl mx-auto mb-16 shadow-2xl shadow-amber-950/5 border border-amber-200/80 backdrop-blur-md">
    <div class="tag-label text-[#FF5E36] mb-3 font-bold">
      TRANSPARENT BILLING
    </div>
    <h2 class="text-3xl sm:text-5xl font-title text-slate-950 tracking-tight leading-tight">
      Choose Your <span class="gradient-warm-text font-bold">Plan</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-slate-600 font-sans leading-relaxed">
      All paid plans include a 7-day free trial. No credit card required to start.
    </p>

    <!-- The Toggle Pill -->
    <div class="mt-10 inline-flex items-center p-1.5 rounded-full bg-slate-100 border border-slate-200 gap-2">
      <button 
        id="toggle-monthly"
        type="button" 
        class="px-7 py-3 rounded-full text-sm font-bold font-sans transition-all bg-[#D4AF37] text-slate-950 shadow-md"
      >
        Monthly
      </button>
      <button 
        id="toggle-annual"
        type="button" 
        class="px-6 py-3 rounded-full text-sm font-medium font-sans text-slate-600 hover:text-slate-950 transition-all flex items-center gap-2"
      >
        <span>Annual</span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-100 text-amber-900 border border-amber-300">
          Save 15%+
        </span>
      </button>
    </div>
  </div>

  <!-- 3 Cards Grid -->
  <div class="pricing-grid grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
    <!-- Free Card -->
    <div class="pricing-card bg-white/95 rounded-3xl p-8 sm:p-10 flex flex-col justify-between space-y-8 shadow-xl border border-amber-200/80 backdrop-blur-md">
      <div class="space-y-4">
        <div class="tag-label text-slate-500 font-mono font-bold">
          Free To Install
        </div>
        <div class="text-5xl sm:text-6xl font-title text-slate-950">
          Free
        </div>
        <div class="text-xs text-slate-500 font-sans">
          Free forever for stores getting started
        </div>

        <ul class="pt-5 border-t border-slate-100 space-y-3.5 text-sm text-slate-700 font-sans">
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Live spot price ticker widget</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Hourly price sync interval</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Basic price calculations</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Up to 10 variants synced</span></li>
        </ul>
      </div>

      <a 
        href="https://apps.shopify.com/spotmetal-pricing-buyback" 
        target="_blank" 
        rel="noopener noreferrer"
        class="block w-full py-3.5 px-4 text-center rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold font-sans text-sm transition-colors shadow-sm"
      >
        Get Started Free
      </a>
    </div>

    <!-- Pro Card -->
    <div class="pricing-card bg-white rounded-3xl p-8 sm:p-10 flex flex-col justify-between space-y-8 shadow-2xl border-2 border-amber-400 relative">
      <div class="space-y-4">
        <div class="tag-label text-amber-600 font-bold">
          Professional
        </div>
        <div class="flex items-baseline gap-1">
          <span class="text-5xl sm:text-6xl font-title text-slate-950 price-val" data-monthly="19" data-annual="16.50">$19</span>
          <span class="text-base text-slate-500 font-sans">/ month</span>
        </div>
        <div class="text-xs text-amber-800 font-mono font-semibold price-subtext">
          or $16.50/mo billed annually (Save 13%)
        </div>
        <div class="text-xs text-amber-700 font-sans font-medium">
          ✦ 7-day free trial included
        </div>

        <ul class="pt-5 border-t border-slate-100 space-y-3.5 text-sm text-slate-700 font-sans">
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Live spot price ticker widget</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>15-minute price sync interval</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Storefront buyback calculator</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Syncs up to 1,000 variants</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Max 20 pricing formulas</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-600 font-bold">✓</span><span>Store location availability</span></li>
        </ul>
      </div>

      <a 
        href="https://apps.shopify.com/spotmetal-pricing-buyback" 
        target="_blank" 
        rel="noopener noreferrer"
        class="block w-full py-4 px-4 text-center rounded-xl gradient-gold-btn text-slate-950 font-bold font-sans text-sm shadow-lg shadow-amber-500/25"
      >
        Start 7-Day Free Trial
      </a>
    </div>

    <!-- Advanced Card (Recommended Luxury Dark Card - Exact Matte Charcoal #131417) -->
    <div class="pricing-card bg-gradient-to-b from-[#1A1B20] to-[#131417] border-2 border-amber-400 rounded-3xl p-8 sm:p-10 flex flex-col justify-between space-y-8 shadow-2xl relative text-white">
      <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-[#FF6B35] to-[#FFA500] text-slate-950 text-xs font-bold font-sans uppercase tracking-wider shadow-md">
        Recommended
      </div>

      <div class="space-y-4">
        <div class="tag-label text-amber-300 font-bold">
          Advanced
        </div>
        <div class="flex items-baseline gap-1">
          <span class="text-5xl sm:text-6xl font-title text-amber-300 price-val" data-monthly="49" data-annual="41.50">$49</span>
          <span class="text-base text-slate-400 font-sans">/ month</span>
        </div>
        <div class="text-xs text-amber-300/90 font-mono price-subtext">
          or $41.50/mo billed annually (Save 15%)
        </div>
        <div class="text-xs text-amber-300/80 font-sans font-medium">
          ✦ 7-day free trial included
        </div>

        <ul class="pt-5 border-t border-white/10 space-y-3.5 text-sm text-slate-100 font-sans">
          <li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span><span>Real-time 1-minute price sync</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span><span>Unlimited formulas & variants</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span><span>Tiered weight bracket pricing</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span><span>Price floor margins protection</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span><span>Manual exchange rate overrides</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span><span>Full buyback dashboard console</span></li>
          <li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span><span>Differential Tax §25a UStG</span></li>
        </ul>
      </div>

      <a 
        href="https://apps.shopify.com/spotmetal-pricing-buyback" 
        target="_blank" 
        rel="noopener noreferrer"
        class="block w-full py-4 px-4 text-center rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold font-sans text-sm shadow-lg shadow-amber-400/20 transition-colors"
      >
        Upgrade to Advanced
      </a>
    </div>
  </div>
</section>

<script>
  const btnMonthly = document.getElementById('toggle-monthly');
  const btnAnnual = document.getElementById('toggle-annual');
  const priceVals = document.querySelectorAll('.price-val');

  if (btnMonthly && btnAnnual) {
    btnMonthly.addEventListener('click', () => {
      btnMonthly.className = 'px-7 py-3 rounded-full text-sm font-bold font-sans transition-all bg-[#D4AF37] text-slate-950 shadow-md';
      btnAnnual.className = 'px-6 py-3 rounded-full text-sm font-medium font-sans text-slate-600 hover:text-slate-950 transition-all flex items-center gap-2';
      priceVals.forEach(el => {
        const val = el.getAttribute('data-monthly');
        if (val) (el as HTMLElement).innerText = `$${val}`;
      });
    });

    btnAnnual.addEventListener('click', () => {
      btnAnnual.className = 'px-7 py-3 rounded-full text-sm font-bold font-sans transition-all bg-[#D4AF37] text-slate-950 shadow-md flex items-center gap-2';
      btnMonthly.className = 'px-6 py-3 rounded-full text-sm font-medium font-sans text-slate-600 hover:text-slate-950 transition-all';
      priceVals.forEach(el => {
        const val = el.getAttribute('data-annual');
        if (val) (el as HTMLElement).innerText = `$${val}`;
      });
    });
  }
</script>
