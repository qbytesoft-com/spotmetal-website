---
import DocsLayout from '../../layouts/DocsLayout.astro';
import DocsSidebar from '../../components/docs/DocsSidebar.astro';
import { docCategories } from '../../data/docs';
---

<DocsLayout 
  title="Documentation Hub & Merchant Wiki"
  description="Comprehensive guides for configuring live precious metal spot prices, karat purity multipliers, and customer buybacks on Shopify."
>
  <div class="flex flex-col lg:flex-row gap-10 xl:gap-16 items-start w-full max-w-full min-w-0 overflow-x-hidden">
    <!-- Left Navigation Sidebar -->
    <DocsSidebar currentSlug="" />

    <!-- Main Content Canvas (Expanded to max-w-5xl / xl:max-w-6xl) -->
    <div class="flex-1 w-full max-w-5xl xl:max-w-6xl space-y-16 py-6 min-w-0 overflow-x-hidden">
      <!-- Hero Welcome Banner (Warm Luminous Peach Accent) -->
      <div class="p-8 sm:p-14 rounded-3xl bg-luminous-warm text-slate-900 border border-amber-300/60 shadow-2xl shadow-amber-950/10 space-y-5">
        <div class="tag-label text-[#FF5E36] font-mono font-bold">
          SPOTMETAL DOCUMENTATION WIKI
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-title text-slate-950 font-medium tracking-tight leading-tight">
          How can we help you <span class="italic font-normal gradient-warm-text">automate today?</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 font-sans leading-relaxed max-w-3xl">
          Complete step-by-step guides, copyable Liquid code snippets, mathematical formula models, and troubleshooting references for precious metal merchants on Shopify.
        </p>

        <!-- Search Bar Trigger in Hero -->
        <div class="pt-4 max-w-2xl">
          <button 
            type="button" 
            data-open-search 
            class="w-full flex items-center justify-between p-4 sm:p-5 rounded-2xl bg-white/95 border border-amber-200 shadow-md text-slate-500 hover:text-slate-900 hover:border-amber-400 transition-all text-sm sm:text-base font-sans"
          >
            <span class="flex items-center gap-3">
              <span class="text-xl">🔍</span>
              <span>Search documentation, formulas, error codes...</span>
            </span>
            <kbd class="px-3 py-1 rounded-lg bg-slate-100 border border-slate-200 font-mono text-xs text-slate-600">⌘K</kbd>
          </button>
        </div>
      </div>

      <!-- 7 Category Cards Grid -->
      <div class="space-y-8">
        <h2 class="text-3xl font-title text-white font-medium">
          Explore by Category
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {docCategories.map(cat => (
            <div class="p-8 sm:p-10 rounded-3xl bg-[#1A1B20] border border-white/10 hover:border-amber-500/40 transition-all shadow-xl space-y-6 flex flex-col justify-between group">
              <div class="space-y-4">
                <div class="text-3xl p-3.5 rounded-2xl bg-[#131417] border border-white/5 w-max group-hover:scale-110 transition-transform">
                  {cat.icon}
                </div>
                <h3 class="text-2xl font-bold font-title text-white">
                  {cat.title}
                </h3>
                <p class="text-sm text-slate-300 font-sans leading-relaxed">
                  {cat.description}
                </p>
              </div>

              <div class="pt-6 border-t border-white/5 space-y-3">
                {cat.articles.map(art => (
                  <a 
                    href={`/docs/${art.slug}`} 
                    class="flex items-center justify-between text-sm font-sans text-slate-400 hover:text-amber-400 py-1.5 transition-colors group/link"
                  >
                    <span>{art.title}</span>
                    <span class="group-hover/link:translate-x-1.5 transition-transform text-amber-400">→</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Quick Help Callout Box -->
      <div class="p-8 sm:p-12 rounded-3xl bg-[#1A1B20] border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="space-y-2 text-center sm:text-left">
          <div class="text-xl font-bold font-title text-white">Can’t find what you’re looking for?</div>
          <div class="text-sm text-slate-300 font-sans">Our integration engineers are available on WhatsApp for custom formula assistance.</div>
        </div>
        <a 
          href="https://api.whatsapp.com/send/?phone=8801611032464&text=Hello+Spotmetal+Support%2C+I+need+help+to+setup.&type=phone_number&app_absent=0" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-8 py-4 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-sans font-bold text-sm shadow-lg transition-colors whitespace-nowrap"
        >
          Chat with Engineer on WhatsApp ↗
        </a>
      </div>
    </div>
  </div>
</DocsLayout>
