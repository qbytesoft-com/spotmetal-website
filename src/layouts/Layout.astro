---
import '../styles/global.css';
import GsapAnimations from '../components/GsapAnimations.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SpotMetal — Live Gold & Precious Metal Pricing for Shopify",
  description = "Connect Shopify stores to real-time Gold, Silver, Platinum, and Palladium spot prices. Automate dynamic jewelry variant pricing, protect margin floors, and power a circular buyback trade-in loop."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/spotmetal-3d-icon.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/spotmetal-3d-icon.jpg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-[#070A0F] text-slate-100 min-h-screen flex flex-col font-sans overflow-x-clip relative selection:bg-amber-500/30 selection:text-white">
    <!-- Ambient Background Spotlights -->
    <div class="ambient-spotlight top-0 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-amber-500/10"></div>
    <div class="ambient-spotlight top-[35%] left-[-100px] w-[600px] h-[600px] bg-emerald-500/5"></div>
    <div class="ambient-spotlight top-[70%] right-[-100px] w-[700px] h-[700px] bg-amber-500/8"></div>

    <slot />
    <GsapAnimations />
  </body>
</html>
