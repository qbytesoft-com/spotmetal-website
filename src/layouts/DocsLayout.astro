---
import '../styles/global.css';
import DocsHeader from '../components/docs/DocsHeader.astro';
import SearchModal from '../components/docs/SearchModal.astro';
import Footer from '../components/Footer.astro';
import WebMcpProvider from '../components/WebMcpProvider.astro';

interface Props {
  title?: string;
  description?: string;
  slug?: string;
  category?: string;
}

const {
  title = "SpotMetal Documentation & Merchant Wiki",
  description = "Learn how to connect Shopify stores to live spot gold prices, configure dynamic karat formulas, and automate circular buyback trade-ins.",
  slug = "",
  category = "Documentation"
} = Astro.props;

const canonicalUrl = slug 
  ? `https://spotmetal.qbytesoft.com/docs/${slug}`
  : `https://spotmetal.qbytesoft.com/docs`;

const docsStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": `${title} — SpotMetal Documentation`,
      "description": description,
      "url": canonicalUrl,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "inLanguage": "en-US",
      "author": {
        "@type": "Organization",
        "name": "SpotMetal Engineering Team",
        "url": "https://spotmetal.qbytesoft.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "SpotMetal Technologies",
        "logo": "https://spotmetal.qbytesoft.com/spotmetal-3d-icon.jpg"
      },
      "about": {
        "@type": "SoftwareApplication",
        "name": "SpotMetal"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://spotmetal.qbytesoft.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Docs",
          "item": "https://spotmetal.qbytesoft.com/docs"
        },
        ...(slug ? [{
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonicalUrl
        }] : [])
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class="dark overflow-x-clip max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/jpeg" href="/spotmetal-3d-icon.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary Meta Tags -->
    <title>{title} — SpotMetal Docs</title>
    <meta name="title" content={`${title} — SpotMetal Docs`} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} — SpotMetal Docs`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/banners/desktop_banner_spot_sync_1787439547210.jpg" />
    <meta property="og:site_name" content="SpotMetal Documentation Wiki" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} — SpotMetal Docs`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/banners/desktop_banner_spot_sync_1787439547210.jpg" />

    <!-- Agent & LLM Discovery Standards -->
    <link rel="llms-txt" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/json" href="/.well-known/ai-plugin.json" title="AI Plugin Manifest" />
    <link rel="alternate" type="application/json" href="/.well-known/mcp.json" title="MCP Server Card" />

    <!-- TechArticle & Breadcrumbs Schema for AEO & Google SGE -->
    <script type="application/ld+json" set:html={JSON.stringify(docsStructuredData)} />
  </head>
  <body class="bg-[#131417] text-slate-100 min-h-screen flex flex-col font-sans overflow-x-clip relative selection:bg-amber-500/30 selection:text-white w-full max-w-full">
    <!-- Ambient Spotlights -->
    <div class="ambient-spotlight top-0 left-1/4 w-[600px] h-[300px] bg-amber-500/5 max-w-full"></div>
    <div class="ambient-spotlight top-[50%] right-0 w-[500px] h-[500px] bg-emerald-500/5 max-w-full"></div>

    <DocsHeader />
    <SearchModal />

    <!-- Expanded Wide Container for Large Screens (max-w-[1600px]) -->
    <main class="flex-1 max-w-[1600px] w-full mx-auto px-4 sm:px-8 lg:px-12 py-8">
      <slot />
    </main>

    <!-- Distinct High-Contrast Conversion Card with Generous Spacing -->
    <section class="my-24 sm:my-32 max-w-6xl mx-auto w-full px-4 sm:px-8 relative z-20">
      <div class="p-8 sm:p-14 rounded-3xl bg-luminous-warm text-slate-900 border border-amber-300/60 shadow-2xl shadow-amber-950/10 flex flex-col sm:flex-row items-center justify-between gap-8 text-center sm:text-left">
        <div class="space-y-3">
          <div class="tag-label text-[#FF5E36] font-mono font-bold">
            READY TO AUTOMATE YOUR STORE?
          </div>
          <h3 class="text-2xl sm:text-4xl font-title text-slate-950 font-medium tracking-tight">
            Install SpotMetal with a <span class="italic font-normal gradient-warm-text">7-Day Free Trial</span>
          </h3>
          <p class="text-sm sm:text-base text-slate-600 font-sans max-w-2xl leading-relaxed">
            Automate real-time bullion pricing, dynamic karat formulas, and customer trade-in appraisals on your Shopify store today.
          </p>
        </div>

        <div class="flex-shrink-0">
          <a 
            href="https://apps.shopify.com/spotmetal-pricing-buyback" 
            target="_blank" 
            rel="noopener noreferrer"
            class="gradient-gold-btn px-9 py-4.5 rounded-2xl text-base font-bold text-slate-950 font-sans shadow-xl shadow-amber-500/20 whitespace-nowrap block"
          >
            Start 7-Day Free Trial →
          </a>
        </div>
      </div>
    </section>

    <Footer />
    <WebMcpProvider />
  </body>
</html>
